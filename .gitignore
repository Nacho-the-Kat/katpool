# Rust build artifacts
/target/
**/*.rs.bk
Cargo.lock.bak

# IDE
.idea/
.vscode/
*.iml
*.swp
*.swo
.DS_Store

# Local environment
.env
.env.*
!.env.example

# Secrets - never commit any decrypted form
*.age
*.key
*.pem
!*.pub.pem
secrets.decrypted.*

# Coverage
/coverage/
*.profraw
tarpaulin-report.html
cobertura.xml
lcov.info

# Test artifacts
**/__snapshots__/
*.snap.new
/tests/fuzz/corpus/
/tests/fuzz/artifacts/

# SBOM / security artifacts (built on demand in CI)
/sbom/
*.cdx.json
*.spdx.json
*.sig
*.cert

# OS / tooling
node_modules/
.cache/
.direnv/
